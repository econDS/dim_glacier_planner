 3 + Slot 2 Lv 1</option>\n                <option value=\"4\">Slot 4 + 3 + Slot 2 Lv 2</option>\n                <option value=\"5\">Slot 4 + 3 + Slot 2 Lv 3</option>\n                <option value=\"6\">Slot 4 + 3 + Slot 2 Lv 4</option>\n                <option value=\"7\">Slot 4 + 3 + Slot 2 Lv 5 (สูงสุด)</option>\n              </select>\n            </label>\n            <label class=\"stage-field\">\n              <span>อยากไปถึง</span>\n              <select id=\"sel_target_stage\" class=\"method-select\" onchange=\"onStageChange('target')\">\n                <option value=\"0\">ไม่ออฟ</option>\n                <option value=\"1\">Slot 4</option>\n                <option value=\"2\">Slot 4 + 3</option>\n                <option value=\"3\">Slot 4 + 3 + Slot 2 Lv 1</option>\n                <option value=\"4\">Slot 4 + 3 + Slot 2 Lv 2</option>\n                <option value=\"5\">Slot 4 + 3 + Slot 2 Lv 3</option>\n                <option value=\"6\">Slot 4 + 3 + Slot 2 Lv 4</option>\n                <option value=\"7\" selected>Slot 4 + 3 + Slot 2 Lv 5 (สูงสุด)</option>\n              </select>\n            </label>\n          </div>\n\n          <div class=\"stepper\" id=\"stage_stepper\"></div>\n          <div class=\"stepper-legend\">\n            <span><i class=\"lg lg-done\"></i>มีแล้ว</span>\n            <span><i class=\"lg lg-todo\"></i>ต้องทำ</span>\n            <span><i class=\"lg lg-skip\"></i>ไม่ได้ทำ</span>\n            <span class=\"hint\" style=\"margin:0;\">กดที่จุดเพื่อเลือกเป้าหมาย</span>\n          </div>\n\n          <div class=\"method-row\" id=\"row_s4_method\">\n            <label for=\"sel_s4_method\"><img class=\"card-title-icon\" src=\"assets/img/slot_34_enchant.png\" alt=\"\" loading=\"lazy\">Slot 4 ใช้:</label>\n            <select id=\"sel_s4_method\" class=\"method-select\" onchange=\"updateEnchant()\">\n              <option value=\"normal\" selected>วัตถุดิบปกติ</option>\n              <option value=\"coupon\">ใช้ Coupon (x1)</option>\n            </select>\n          </div>\n          <div class=\"method-row\" id=\"row_s3_method\">\n            <label for=\"sel_s3_method\"><img class=\"card-title-icon\" src=\"assets/img/slot_34_enchant.png\" alt=\"\" loading=\"lazy\">Slot 3 ใช้:</label>\n            <select id=\"sel_s3_method\" class=\"method-select\" onchange=\"updateEnchant()\">\n              <option value=\"normal\" selected>วัตถุดิบปกติ</option>\n              <option value=\"coupon\">ใช้ Coupon (x2)</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- SHOPPING LIST -->\n      <div class=\"interactive-card\" id=\"card_shop\">\n        <div class=\"card-top\">\n          <div class=\"card-title\">3. ต้องเตรียมทั้งหมด</div>\n          <div class=\"view-toggle\" role=\"group\" aria-label=\"รูปแบบรายการ\">\n            <button type=\"button\" class=\"view-btn active\" data-view=\"finished\">ของสำเร็จ</button>\n            <button type=\"button\" class=\"view-btn\" data-view=\"raw\">แตกเป็นวัตถุดิบ</button>\n          </div>\n        </div>\n        <div class=\"card-body\">\n          <div class=\"shop-summary\" id=\"shop_summary\"></div>\n          <table class=\"shop-table\">\n            <tbody id=\"shop_list\"></tbody>\n          </table>\n          <div class=\"shop-foot\">\n            <div class=\"hint\" id=\"shop_note\" style=\"margin:0;\"></div>\n            <button type=\"button\" class=\"toolbar-btn\" id=\"btn_copy_shop\">คัดลอกรายการ</button>\n          </div>\n\n          <details class=\"step-details\">\n            <summary>ดูแยกทีละขั้น</summary>\n            <table class=\"s2-table\">\n              <thead>\n                <tr>\n                  <th>ขั้น</th>\n                  <th>วัตถุดิบที่ต้องใช้</th>\n                  <th style=\"text-align:right\">ค่าใช้จ่าย</th>\n                </tr>\n              </thead>\n              <tbody id=\"list_steps\"></tbody>\n            </table>\n          </details>\n        </div>\n      </div>\n\n      <!-- REFINE -->\n      <div class=\"interactive-card\">\n        <div class=\"card-top\">\n          <div class=\"card-title\">4. การ Refine และ Upgrade</div>\n          <div class=\"card-cost\" id=\"cost_refine\">0</div>\n        </div>\n        <div class=\"card-body\">\n          <div class=\"input-group\">\n            <div>\n              <strong><label for=\"qty_cube\"><span class=\"item-chip item-chip-tight\"><img class=\"item-icon item-icon-sm\" src=\"assets/img/Dim%20Glacier%20Weapon%209%20Refine%20Cube.png\" alt=\"Dim Glacier Weapon 9 Refine Cube\" loading=\"lazy\"><span class=\"item item-label\" data-item=\"Dim Glacier Weapon 9 Refine Cube\" data-copy=\"Dim Glacier Weapon 9 Refine Cube\">Dim Glacier Weapon 9 Refine Cube</span></span></label></strong>\n              <div style=\"font-size:11px; color:#888;\">+9 ทันที (ราคาตลาด)</div>\n            </div>\n            <div>\n              <input type=\"number\" id=\"qty_cube\" value=\"0\" min=\"0\" style=\"width:50px; text-align:center;\" onchange=\"updateRefine()\" onkeyup=\"updateRefine()\">\n              <span style=\"font-size:12px;\">ชิ้น</span>\n            </div>\n          </div>\n\n          <div class=\"input-group\" style=\"margin-top:10px;\">\n            <div>\n              <strong><label for=\"qty_device\"><span class=\"item-chip item-chip-tight\"><img class=\"item-icon item-icon-sm\" src=\"assets/img/Dim%20Glacier%20Refinement%20Device.png\" alt=\"Dim Glacier Refinement Device\" loading=\"lazy\"><span class=\"item item-label\" data-item=\"Dim Glacier Refinement Device\" data-copy=\"Dim Glacier Refinement Device\">Dim Glacier Refinement Device</span></span></label></strong>\n              <div style=\"font-size:11px; color:var(--green);\">Safety +1 (Best Price อัตโนมัติ: Craft/Market) + รวมค่าใช้ตอนใช้งาน</div>\n              <div class=\"hint consume-line\">\n                <span>Consume ต่อกล่อง:</span>\n                <span class=\"consume-list\">\n                  <span class=\"consume-item\"><span class=\"consume-qty\">40x</span><span class=\"item-chip item-chip-tight\"><img class=\"item-icon item-icon-sm\" src=\"assets/img/Snow%20Flower%20Petal.png\" alt=\"Snow Flower Petal\" loading=\"lazy\"><span class=\"item item-label\" data-item=\"Snow Flower Petal\" data-copy=\"Snow Flower Petal\">Snow Flower Petal</span></span></span>\n                  <span class=\"consume-item\"><span class=\"consume-qty\">10x</span><span class=\"item-chip item-chip-tight\"><img class=\"item-icon item-icon-sm\" src=\"assets/img/Encroached%20Magical%20Crystal.png\" alt=\"Encroached Magical Crystal\" loading=\"lazy\"><span class=\"item item-label\" data-item=\"Encroached Magical Crystal\" data-copy=\"Encroached Magical Crystal\">Encroached Magical Crystal</span></span></span>\n                  <span class=\"consume-item\"><span class=\"consume-qty\">10x</span><span class=\"item-chip item-chip-tight\"><img class=\"item-icon item-icon-sm\" src=\"assets/img/Neutralized%20Magical%20Crystal.png\" alt=\"Neutralized Magical Crystal\" loading=\"lazy\"><span class=\"item item-label\" data-item=\"Neutralized Magical Crystal\" data-copy=\"Neutralized Magical Crystal\">Neutralized Magical Crystal</span></span></span>\n                </span>\n              </div>\n            </div>\n            <div>\n              <input type=\"number\" id=\"qty_device\" value=\"0\" min=\"0\" style=\"width:50px; text-align:center;\" onchange=\"updateRefine()\" onkeyup=\"updateRefine()\">\n              <span style=\"font-size:12px;\">ชิ้น</span>\n            </div>\n          </div>\n\n          <div class=\"input-group\" style=\"margin-top:10px; border-top:1px dashed #eee; padding-top:10px;\">\n            <label for=\"manual_cost\">งบ Refine กำหนดเอง (แร่/ค่าธรรมเนียม)</label>\n            <input type=\"text\" id=\"manual_cost\" value=\"0\" inputmode=\"numeric\"\n                   style=\"width:100px;\"\n                   oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\">\n          </div>\n        </div>\n      </div>\n\n      <!-- GIMMICK -->\n      <div class=\"gimmick-box\">\n        <div class=\"gimmick-title\" id=\"gimmick_title\">วิเคราะห์สไตล์ผู้เล่น</div>\n        <div id=\"gimmick_msg\">กำลังคำนวณ...</div>\n      </div>\n\n      <!-- TOTAL -->\n      <div class=\"grand-total\">\n        <div style=\"font-size:14px; opacity:0.8;\">งบประมาณรวมทั้งหมด</div>\n        <div style=\"font-size:42px; font-weight:bold; margin:5px 0;\" id=\"total_zeny\">0 Zeny</div>\n        <div style=\"font-size:24px; color:#f1c40f;\" id=\"total_thb\">0 THB</div>\n      </div>\n    </div>    <!-- LEFT COLUMN: SETTINGS -->\n    <div class=\"left-col\">\n      <div class=\"card\" id=\"card_market\">\n        <div class=\"section-header\">ราคาตลาด (Zeny)</div>\n        <div style=\"margin:-8px 0 14px; font-size:12px; color:#888;\">\n          ชุดราคาเริ่มต้น: <strong id=\"default_price_date\">12 เม.ย. 2569</strong>\n          <div>ราคาของคุณแก้ไขล่าสุด: <span id=\"price_last_modified\">—</span></div>\n        </div>\n        <div class=\"market-warning\">\n          เว็บไซต์นี้ไม่ได้อัปเดตราคาให้อัตโนมัติ ผู้ใช้ต้องอัปเดตข้อมูลเอง และสามารถใช้ฟังก์ชันนำเข้า/ส่งออกในส่วนจัดการข้อมูลช่วยจัดการข้อมูลได้\n        </div>\n        <div class=\"input-group\">\n          <label for=\"rate_thb\">อัตราแลกเปลี่ยน (1M = ? บาท)</label>\n          <input type=\"text\" id=\"rate_thb\" value=\"7.4\" inputmode=\"decimal\"\n                 oninput=\"sanitizeRateTyping(this)\" onblur=\"normalizeRateOnBlur(this)\">\n        </div>\n\n        <div style=\"margin:15px 0 5px; font-weight:bold; font-size:12px; color:#888;\">วัตถุดิบ</div>\n        <div class=\"input-group\"><label for=\"p_petal\">Snow Flower Petal</label><input type=\"text\" id=\"p_petal\" value=\"10,400\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_amethyst\">Amethyst Fragment</label><input type=\"text\" id=\"p_amethyst\" value=\"8,550\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_enc_ore\">Encroached Magical Ore</label><input type=\"text\" id=\"p_enc_ore\" value=\"1,200\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_neu_ore\">Neutralized Magical Ore</label><input type=\"text\" id=\"p_neu_ore\" value=\"20,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_miasmal\">Miasmal Spell</label><input type=\"text\" id=\"p_miasmal\" value=\"340,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_sf_stone\">Snow Flower Magic Stone</label><input type=\"text\" id=\"p_sf_stone\" value=\"7,500\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"p_shining_stone\">Shining Snow Flower Magic Stone</label><input type=\"text\" id=\"p_shining_stone\" value=\"27,500\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\" style=\"border-left:3px solid var(--orange); padding-left:5px;\">\n          <label for=\"p_brilliant\">Brilliant Snow Flower Magic Stone Extract</label>\n          <input type=\"text\" id=\"p_brilliant\" value=\"1,740,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\">\n        </div>\n\n        <div style=\"margin:15px 0 5px; font-weight:bold; font-size:12px; color:#888;\">ไอเทมสำเร็จรูป</div>\n        <div class=\"input-group\"><label for=\"m_sf_extract\">Snow Flower Magic Stone Extract</label><input type=\"text\" id=\"m_sf_extract\" value=\"500,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"m_shining_extract\">Shining Snow Flower Magic Stone Extract</label><input type=\"text\" id=\"m_shining_extract\" value=\"150,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"m_glacier_extract\">Glacier Extract</label><input type=\"text\" id=\"m_glacier_extract\" value=\"2,390,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"m_enc_crystal\">Encroached Magical Crystal</label><input type=\"text\" id=\"m_enc_crystal\" value=\"1,200,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\"><label for=\"m_neu_crystal\">Neutralized Magical Crystal</label><input type=\"text\" id=\"m_neu_crystal\" value=\"380,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n        <div class=\"input-group\" style=\"border-left:3px solid var(--green); padding-left:5px;\">\n          <label for=\"m_device\">Dim Glacier Refinement Device</label>\n          <input type=\"text\" id=\"m_device\" value=\"22,450,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\">\n        </div>\n\n        <div style=\"margin:15px 0 5px; font-weight:bold; font-size:12px; color:#888;\">รายการพิเศษ</div>\n        <div class=\"input-group\"><label for=\"m_weapon\" style=\"color:var(--accent); font-weight:bold;\">Dim Glacier Weapon</label><input type=\"text\" id=\"m_weapon\" value=\"50,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\"></div>\n\n        <div class=\"input-group\">\n          <label for=\"p_coupon\" style=\"color:var(--purple);\">Slot 4 & 3 Dim Glacier Enchant Coupon</label>\n          <input type=\"text\" id=\"p_coupon\" value=\"35,500,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\" style=\"border-color:var(--purple);\">\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"m_cube9\" style=\"color:var(--orange);\">Dim Glacier Weapon 9 Refine Cube</label>\n          <input type=\"text\" id=\"m_cube9\" value=\"50,000,000\" inputmode=\"numeric\" oninput=\"sanitizeNumberTyping(this)\" onblur=\"formatOnBlur(this)\" style=\"border-color:var(--orange);\">\n        </div>\n      </div>\n\n      <div class=\"card toolbar-card\">\n        <div class=\"section-header\">จัดการข้อมูล</div>\n        <div class=\"toolbar-actions\">\n          <button type=\"button\" class=\"toolbar-btn primary\" id=\"btn_import\">นำเข้าไฟล์</button>\n          <button type=\"button\" class=\"toolbar-btn\" id=\"btn_reset\">รีเซ็ตข้อมูล</button>\n          <button type=\"button\" class=\"toolbar-btn\" id=\"btn_export_json\">ส่งออก JSON</button>\n          <button type=\"button\" class=\"toolbar-btn\" id=\"btn_export_csv\">ส่งออก CSV</button>\n          <button type=\"button\" class=\"toolbar-btn\" id=\"btn_export_excel\" style=\"grid-column:1 / -1;\">ส่งออก Excel</button>\n        </div>\n        <div class=\"toolbar-meta\">\n          บันทึกค่าอัตโนมัติลง localStorage ทุกครั้งที่แก้ไข และรองรับการนำเข้า/ส่งออก .json, .csv, .xlsx\n        </div>\n        <div id=\"storage_status\">พร้อมใช้งาน</div>\n        <input type=\"file\" id=\"file_import\" accept=\".json,.csv,.xlsx,.xls\" hidden>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"section-header\">วิเคราะห์ราคาที่คุ้มที่สุด</div>\n        <table class=\"tb-best\">\n          <tbody id=\"tb_compare\"></tbody>\n        </table>\n        <div class=\"hint\">\n          * ตารางนี้เทียบเฉพาะ “ต้นทุนต่อกล่องตอนหาได้มา” (Craft vs Market) — ยังไม่รวม Consume ตอ